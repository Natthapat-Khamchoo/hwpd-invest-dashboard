{
  "crons": [
    { "path": "/api/line/daily-report", "schedule": "0 1 * * *" }
  ],
  "functions": {
    "api/line/daily-report.js": { "maxDuration": 120, "memory": 2048 }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://hwpd-next-gen.vercel.app https://hwpd-next-gen2.vercel.app https://hwpd-next-gen-d398.vercel.app" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}